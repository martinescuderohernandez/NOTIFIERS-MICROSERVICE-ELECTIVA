# ==========================================
# Notifier Microservice — Environment Variables
# ==========================================

# Application
NODE_ENV=development
PORT=8001

# ==========================================
# Apache Kafka Configuration (Aiven)
# ==========================================
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-11a18fa7-tercer-corte-electiva.d.aivencloud.com:27108
KAFKA_CLIENT_ID=notifier-service
KAFKA_GROUP_ID=notifier-service-group
KAFKA_SECURITY_PROTOCOL=SSL

# Topics (must match what Users and Accounts publish to)
KAFKA_TOPIC_USER_CREATED=user-created-topic
KAFKA_TOPIC_USER_UPDATED=user-updated-topic
KAFKA_TOPIC_USER_DELETED=user-deleted-topic
KAFKA_TOPIC_ACCOUNT_CREATED=account-created-topic

# Kafka SSL Certificates (Aiven)
# En local: rutas relativas a ./certs/
# En Render: usar Secret Files en /etc/secrets/
KAFKA_SSL_CAFILE=./certs/ca.pem
KAFKA_SSL_CERTFILE=./certs/service.cert
KAFKA_SSL_KEYFILE=./certs/service.key

# ==========================================
# Brevo SMTP Configuration
# ==========================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_EMAIL=noreply@tudominio.com
SMTP_FROM_NAME=Sistema de Notificaciones
